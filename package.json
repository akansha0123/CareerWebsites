{
  "name": "careerwebsites",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "smoke": "npx playwright test --grep \"@smoke\"",
    "smokewithAllureReport": "npx playwright test --config playwright.config.js --reporter=allure-playwright",
    "SafariNewConfig": "npx playwright test --config playwright.configNew.js --project=safari",
    "report": "allure generate allure-results --clean && allure open allure-report",
    "test:allure": "playwright test --reporter=allure-playwright",
    "allure:generate": "allure generate allure-results --clean",
    "generate:pdf": "node scripts/PDFconversions.js",
    "test:full-report": "npm run test:allure && npm run allure:generate && npm run generate:pdf",
    "postinstall": "npx playwright install --with-deps",
    "test": "npx playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.3.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "html-pdf-node": "^1.0.8",
    "puppeteer": "^24.24.1"
  }
}
